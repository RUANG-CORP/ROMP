<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16">

    <!-- ReSA:MP Header / Branding Bar (100% Ad-Free) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="#0D1526"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <!-- Logo & Title Group -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ReSA"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":MP"
                    android:textColor="#38BDF8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOBILE"
                    android:textColor="#38BDF8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_ping"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPEN.MP &amp; SA-MP MULTIPLAYER CLIENT"
                android:textColor="#64748B"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Direct Connect Action Button -->
        <Button
            android:id="@+id/btn_add_server"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ TAMBAH SERVER"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_connect"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>

    <!-- Top Navigation Tabs: FAVORIT | SERVERS | PENGATURAN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#0F172A">

        <Button
            android:id="@+id/tab_favorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⭐ FAVORIT"
            android:textColor="#38BDF8"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_internet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🌐 SERVERS"
            android:textColor="#94A3B8"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙️ PENGATURAN"
            android:textColor="#94A3B8"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B" />

    <!-- Main Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp">

        <!-- Container 1: Server List View (Favorites / Internet) with Search Bar -->
        <LinearLayout
            android:id="@+id/layout_server_list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_search_servers"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:hint="🔍 Cari server (nama, IP, atau gamemode)..."
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:background="@drawable/bg_search_bar"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <ListView
                android:id="@+id/lv_servers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:listSelector="@android:color/transparent"
                android:scrollbarThumbVertical="@android:color/transparent" />
        </LinearLayout>

        <!-- Container 2: Settings View -->
        <ScrollView
            android:id="@+id/layout_settings_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- CARD 1: Profil Pemain -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_section"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤 PROFIL PEMAIN"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nickname Pemain (3-20 Karakter):"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/et_nickname"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Player_Name"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#475569"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- CARD 2: Engine & Gameplay Settings -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_section"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️ ENGINE &amp; GAMEPLAY"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Batas FPS (FPS Limit):"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spinner_fps"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:layout_marginBottom="14dp" />

                    <CheckBox
                        android:id="@+id/cb_fast_chat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aktifkan Fast Chat (Samp)"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/cb_voice_chat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aktifkan Voice Chat Plugin (Audio)"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp"
                        android:layout_marginBottom="14dp" />

                    <Button
                        android:id="@+id/btn_save_settings"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="SIMPAN PENGATURAN"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_btn_connect"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- CARD 3: Data Game & Cache Manager -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_section"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 DATA GAME GTA SA &amp; CACHE"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Integritas Game Data (texdb/gta3.img &amp; data/gta.dat):"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_cache_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:background="@drawable/bg_input_field"
                        android:text="Memeriksa data GTA SA..."
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="URL CDN Data Cache (ZIP):"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/et_cache_url"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="https://domain.com/gtasa_cache.zip"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#475569"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="12sp"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <Button
                            android:id="@+id/btn_download_cache"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="DOWNLOAD DARI CDN"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_btn_connect"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btn_install_local_zip"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="PASANG ZIP LOKAL"
                            android:textColor="#CBD5E1"
                            android:background="@drawable/bg_btn_secondary"
                            android:textSize="11sp"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_mock_cache"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="⚡ BUAT DATA UJI COBA (OFFLINE INSTANT)"
                        android:textColor="#CBD5E1"
                        android:background="@drawable/bg_btn_secondary"
                        android:textSize="11sp"
                        android:layout_marginBottom="14dp" />

                    <ProgressBar
                        android:id="@+id/pb_cache_download"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        android:visibility="gone"
                        android:layout_marginBottom="10dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</LinearLayout>
