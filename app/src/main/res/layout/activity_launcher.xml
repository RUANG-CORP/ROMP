<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#070A10">

    <!-- 1. LEFT NAVIGATION RAIL (ReSA Sidebar) -->
    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_nav_rail"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- ReSA Emblem Logo -->
        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/resa_emblem"
            android:contentDescription="ReSA Emblem"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp" />

        <!-- Nav Item 1: Home / Quick Play -->
        <Button
            android:id="@+id/btn_nav_home"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🏠\nMAIN"
            android:textColor="#38BDF8"
            android:background="@drawable/bg_nav_item_selected"
            android:textSize="9sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="8dp" />

        <!-- Nav Item 2: Servers Browser -->
        <Button
            android:id="@+id/btn_nav_servers"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🌐\nSERVER"
            android:textColor="#94A3B8"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="9sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="8dp" />

        <!-- Nav Item 3: Game Files / Cache -->
        <Button
            android:id="@+id/btn_nav_files"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="📦\nBERKAS"
            android:textColor="#94A3B8"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="9sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="8dp" />

        <!-- Nav Item 4: Settings -->
        <Button
            android:id="@+id/btn_nav_settings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="⚙️\nSETELAN"
            android:textColor="#94A3B8"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="9sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="8dp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- App Version Tag -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.1.6"
            android:textColor="#475569"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. RIGHT CONTENT AREA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0C121E"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ReSA Multiplayer"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.1.6"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_ping"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPEN.MP &amp; SA-MP MOBILE CLIENT · 100% AD-FREE"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Direct Connect button -->
            <Button
                android:id="@+id/btn_add_server"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ TAMBAH SERVER"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_connect"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#192334" />

        <!-- Dynamic Content Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="14dp">

            <!-- ============================================== -->
            <!-- TAB 1: HOME / QUICK PLAY DASHBOARD             -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/layout_home_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- Left Column: Profile & Main Action -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                    android:orientation="vertical">

                    <!-- Nickname Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_section"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👤 NAMA PANGGILAN (NICKNAME)"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/et_nickname"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:hint="Atur nama panggilan..."
                            android:textColor="#FFFFFF"
                            android:textColorHint="#475569"
                            android:background="@drawable/bg_input_field"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Selected Server Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_section"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎮 SERVER TERPILIH"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tv_home_selected_server_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ruang Roleplay"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tv_home_selected_server_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="18.142.244.146:7777 · Roleplay"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_home_selected_server_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚡ 24 ms  ·  👥 0 / 200 Pemain"
                            android:textColor="#10B981"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Big Play Button: MAIN ONLINE -->
                    <Button
                        android:id="@+id/btn_main_online"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="▶ MAIN ONLINE"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_btn_connect"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- Secondary Play Button: Main offline -->
                    <Button
                        android:id="@+id/btn_main_offline"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Main offline (Singleplayer)"
                        android:textColor="#CBD5E1"
                        android:background="@drawable/bg_btn_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Footer -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Designed &amp; developed by Alyn · 100% Ad-Free"
                        android:textColor="#475569"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="14dp"
                    android:layout_height="match_parent" />

                <!-- Right Column: Popular Now Feed -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="6"
                    android:orientation="vertical">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔥 POPULER SEKARANG"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ketuk server untuk memilih"
                            android:textColor="#38BDF8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Popular Server List -->
                    <ListView
                        android:id="@+id/lv_popular_servers"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:divider="@null"
                        android:dividerHeight="0dp"
                        android:listSelector="@android:color/transparent"
                        android:layout_marginBottom="8dp" />

                    <!-- Bottom Social Links -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_link_discord"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Discord"
                            android:textColor="#CBD5E1"
                            android:background="@drawable/bg_btn_secondary"
                            android:textSize="10sp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btn_link_telegram"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Telegram"
                            android:textColor="#CBD5E1"
                            android:background="@drawable/bg_btn_secondary"
                            android:textSize="10sp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btn_link_website"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Situs web"
                            android:textColor="#CBD5E1"
                            android:background="@drawable/bg_btn_secondary"
                            android:textSize="10sp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btn_link_about"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Tentang"
                            android:textColor="#CBD5E1"
                            android:background="@drawable/bg_btn_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ============================================== -->
            <!-- TAB 2: SERVERS BROWSER (MASTER-DETAIL VIEW)    -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/layout_server_list_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <!-- Left Pane: Subtabs, Search, Server List -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:orientation="vertical">

                    <!-- Subtabs: Tersimpan | Resmi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:orientation="horizontal"
                        android:background="#0F172A"
                        android:layout_marginBottom="8dp">

                        <Button
                            android:id="@+id/tab_favorites"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="⭐ Tersimpan"
                            android:textColor="#38BDF8"
                            android:background="?android:attr/selectableItemBackground"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/tab_internet"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="🌐 Resmi / Publik"
                            android:textColor="#94A3B8"
                            android:background="?android:attr/selectableItemBackground"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Search Input -->
                    <EditText
                        android:id="@+id/et_search_servers"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="🔍 Cari server (nama, IP, gamemode)..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#475569"
                        android:background="@drawable/bg_search_bar"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <!-- Servers List -->
                    <ListView
                        android:id="@+id/lv_servers"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:divider="@null"
                        android:dividerHeight="0dp"
                        android:listSelector="@android:color/transparent" />
                </LinearLayout>

                <View
                    android:layout_width="14dp"
                    android:layout_height="match_parent" />

                <!-- Right Pane: Server Inspector / Details Sheet -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_section"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_pane_server_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pilih server di sebelah kiri"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tv_pane_server_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alamat IP: -"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Stats Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_input_field"
                        android:padding="8dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tv_pane_server_ping"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ping: -"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_pane_server_players"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pemain: -"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_pane_server_gamemode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="Mode: -"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Rules Box -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ATURAN SERVER (RULES)"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tv_pane_server_rules"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="8dp"
                        android:text="Ketuk server untuk memuat rules UDP..."
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:layout_marginBottom="8dp" />

                    <!-- Players List Box -->
                    <TextView
                        android:id="@+id/tv_pane_players_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DAFTAR PEMAIN ONLINE"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="2dp" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:padding="8dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/tv_pane_server_players_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Memuat daftar pemain..."
                            android:textColor="#CBD5E1"
                            android:textSize="11sp"
                            android:lineSpacingExtra="3dp" />
                    </ScrollView>

                    <!-- Connect Button in Pane -->
                    <Button
                        android:id="@+id/btn_pane_connect"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="▶ HUBUNGKAN KE SERVER"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_btn_connect"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- ============================================== -->
            <!-- TAB 3: BERKAS (GAME CACHE & DATA MANAGER)      -->
            <!-- ============================================== -->
            <ScrollView
                android:id="@+id/layout_files_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Cache Status Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_section"
                        android:padding="16dp"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📦 BERKAS GIM GTA SA"
                            android:textColor="#38BDF8"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/tv_cache_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:background="@drawable/bg_input_field"
                            android:text="Memeriksa berkas gim..."
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="URL CDN Data Cache (ZIP):"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/et_cache_url"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:hint="https://domain.com/gtasa_cache.zip"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#475569"
                            android:background="@drawable/bg_input_field"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="10dp">

                            <Button
                                android:id="@+id/btn_download_cache"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_weight="1"
                                android:text="UNDUH DARI CDN"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/bg_btn_connect"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btn_install_local_zip"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_weight="1"
                                android:text="PASANG ZIP LOKAL"
                                android:textColor="#CBD5E1"
                                android:background="@drawable/bg_btn_secondary"
                                android:textSize="11sp"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_mock_cache"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="⚡ BUAT DATA UJI COBA (OFFLINE INSTANT)"
                            android:textColor="#CBD5E1"
                            android:background="@drawable/bg_btn_secondary"
                            android:textSize="11sp"
                            android:layout_marginBottom="12dp" />

                        <ProgressBar
                            android:id="@+id/pb_cache_download"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:max="100"
                            android:progress="0"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Folder Tree Structure Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_section"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📁 STRUKTUR FOLDER GIM"
                            android:textColor="#38BDF8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• /SAMP/settings.ini (Konfigurasi Client)\n• /texdb/gta3.img &amp; gta_int.img (Tekstur Game)\n• /data/gta.dat (Konfigurasi Data)\n• /anim/ &amp; /audio/ (Animasi dan Suara GTA SA)"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ============================================== -->
            <!-- TAB 4: SETELAN (SETTINGS & ENGINE CONFIG)       -->
            <!-- ============================================== -->
            <ScrollView
                android:id="@+id/layout_settings_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_section"
                        android:padding="16dp"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚙️ PENGATURAN MULTIPEMAIN &amp; ENGINE"
                            android:textColor="#38BDF8"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Batas FPS (FPS Limit):"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinner_fps"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_field"
                            android:layout_marginBottom="14dp" />

                        <CheckBox
                            android:id="@+id/cb_fast_chat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Aktifkan Fast Chat (Samp)"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <CheckBox
                            android:id="@+id/cb_voice_chat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Aktifkan Voice Chat Plugin (Audio)"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp"
                            android:layout_marginBottom="14dp" />

                        <Button
                            android:id="@+id/btn_save_settings"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:text="SIMPAN PENGATURAN"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_btn_connect"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
