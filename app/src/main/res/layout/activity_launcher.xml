<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16">

    <!-- Header / Branding Bar (Ad-Free) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#0F172A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SA-MP Mobile Launcher"
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_add_server"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ Tambah Server"
            android:textColor="#FFFFFF"
            android:background="#0284C7"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Top Navigation Tabs: FAVORIT | INTERNET | PENGATURAN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#1E293B">

        <Button
            android:id="@+id/tab_favorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="FAVORIT"
            android:textColor="#38BDF8"
            android:background="?android:attr/selectableItemBackground"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_internet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="INTERNET"
            android:textColor="#94A3B8"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PENGATURAN"
            android:textColor="#94A3B8"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Main Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <!-- Container 1: Server List View (Favorites / Internet) with Search Bar -->
        <LinearLayout
            android:id="@+id/layout_server_list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_search_servers"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="Cari server (nama, IP, gamemode)..."
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:background="#1E293B"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <ListView
                android:id="@+id/lv_servers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp" />
        </LinearLayout>

        <!-- Container 2: Settings View (Hidden by default) -->
        <ScrollView
            android:id="@+id/layout_settings_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nickname Pemain"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Player_Name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:background="#1E293B"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Batas FPS (FPS Limit)"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinner_fps"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#1E293B"
                    android:layout_marginBottom="14dp" />

                <CheckBox
                    android:id="@+id/cb_fast_chat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aktifkan Fast Chat (Samp)"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/cb_voice_chat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aktifkan Voice Chat Audio (Plugin)"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    android:layout_marginBottom="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="URL CDN Data Cache (ZIP)"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_cache_url"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="https://domain.com/gtasa_cache.zip"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:background="#1E293B"
                    android:padding="10dp"
                    android:textSize="12sp"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Integritas Game Data (Cache Status)"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_cache_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="#1E293B"
                    android:text="Memeriksa data GTA SA..."
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/btn_download_cache"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="DOWNLOAD DARI CDN"
                        android:textColor="#FFFFFF"
                        android:background="#10B981"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_install_local_zip"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="PASANG DARI ZIP LOKAL"
                        android:textColor="#FFFFFF"
                        android:background="#0284C7"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_mock_cache"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="⚡ BUAT DATA UJI COBA (OFFLINE INSTANT)"
                    android:textColor="#CBD5E1"
                    android:background="#334155"
                    android:textSize="11sp"
                    android:layout_marginBottom="14dp" />

                <ProgressBar
                    android:id="@+id/pb_cache_download"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:visibility="gone"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btn_save_settings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="SIMPAN PENGATURAN"
                    android:textColor="#FFFFFF"
                    android:background="#0284C7"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</LinearLayout>
