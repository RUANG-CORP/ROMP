<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:padding="14dp"
    android:background="@drawable/bg_server_card">

    <!-- Top Row: Status Dot, Server Name, Ping Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/view_status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_online"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tv_server_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Server Hostname"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_server_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45ms"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_ping"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Middle Row: IP Address & Players Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_server_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="127.0.0.1:7777"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_server_players"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25 / 100"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:background="@drawable/bg_badge_players"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Bottom Action Row: Delete & Connect -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical|end">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ketuk untuk melihat detail server"
            android:textColor="#475569"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_delete_server"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="HAPUS"
            android:textColor="#EF4444"
            android:background="@drawable/bg_btn_danger"
            android:textSize="11sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_connect_server"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="▶ GABUNG"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_connect"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

</LinearLayout>
