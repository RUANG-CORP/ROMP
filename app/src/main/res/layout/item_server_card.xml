<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:padding="14dp"
    android:background="@drawable/bg_server_card"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Row: Status Indicator, Server Title, Ping Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/view_status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_online"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tv_server_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Server Hostname"
            android:textColor="@color/romp_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:drawablePadding="6dp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_server_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45ms"
            android:textColor="@color/romp_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_ping"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Middle Row: Address + Gamemode + Players Capacity Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_server_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="127.0.0.1:7777"
            android:textColor="@color/romp_text_secondary"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_server_players"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25 / 100"
            android:textColor="@color/romp_text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_players"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Subtle Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/romp_divider"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <!-- Bottom Action Row: Hint + >=44dp Touch Targets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ketuk kartu untuk detail server"
            android:textColor="@color/romp_text_muted"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btn_delete_server"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="80dp"
            android:text="Hapus"
            android:textAllCaps="false"
            android:textColor="@color/romp_danger"
            android:background="@drawable/bg_btn_danger"
            android:drawableStart="@drawable/ic_romp_trash"
            android:drawablePadding="6dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_connect_server"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="104dp"
            android:text="Gabung"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_connect"
            android:drawableStart="@drawable/ic_romp_play"
            android:drawablePadding="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

</LinearLayout>
