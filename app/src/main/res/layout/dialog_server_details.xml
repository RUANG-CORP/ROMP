<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_modern"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_details_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server Hostname"
        android:textColor="@color/romp_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <View
            android:id="@+id/view_details_status"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_online"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tv_details_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="127.0.0.1:7777"
            android:textColor="@color/romp_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_details_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="35ms"
            android:textColor="@color/romp_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_ping"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_section"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tv_details_gamemode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gamemode: Roleplay"
            android:textColor="@color/romp_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_details_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rules: lagcomp=On | version=0.3.7"
            android:textColor="@color/romp_text_muted"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_details_players_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pemain Online (Memuat...)"
            android:textColor="@color/romp_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE QUERY"
            android:textColor="@color/romp_success"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_details_players_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memuat daftar pemain..."
            android:textColor="@color/romp_text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_details_close"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="Tutup"
            android:textAllCaps="false"
            android:textColor="@color/romp_text_secondary"
            android:background="@drawable/bg_btn_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btn_details_connect"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.4"
            android:text="Gabung Server"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_connect"
            android:drawableStart="@drawable/ic_romp_play"
            android:drawablePadding="8dp"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
