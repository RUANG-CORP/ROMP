<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E293B"
    android:padding="16dp">

    <!-- Header: Server Name -->
    <TextView
        android:id="@+id/tv_details_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server Hostname"
        android:textColor="#F8FAFC"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Address & Ping / Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <View
            android:id="@+id/view_details_status"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#10B981"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tv_details_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="127.0.0.1:7777"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_details_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="35ms"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginBottom="12dp" />

    <!-- Info Grid / Overview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0F172A"
        android:padding="10dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_details_gamemode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gamemode: Roleplay"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_details_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rules: lagcomp=On | version=0.3.7 | weather=10"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Players Header -->
    <TextView
        android:id="@+id/tv_details_players_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pemain Online (Memuat...)"
        android:textColor="#F8FAFC"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Players List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#0F172A"
        android:padding="8dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_details_players_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memuat daftar pemain..."
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp" />
    </ScrollView>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_details_close"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="TUTUP"
            android:textColor="#CBD5E1"
            android:background="#334155"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_details_connect"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="GABUNG KE SERVER"
            android:textColor="#FFFFFF"
            android:background="#0284C7"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
